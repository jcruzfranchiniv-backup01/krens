# Sin secretos reales en el repo. Copiar a .env (local) o cargar en Vercel.
PUBLIC_SITE_URL=https://dominio-del-cliente.com.ar

# Tracking (vacío = no se carga el script)
PUBLIC_META_PIXEL_ID=
PUBLIC_GA4_ID=

# Guardado de leads: Web App de Google Apps Script (ver docs/google-sheets.gs)
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=

# Panel /admin. El hash se genera con: npm run admin:hash
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Hosts permitidos para imágenes (coma). Vacío = res.cloudinary.com
ADMIN_IMAGE_HOSTS=
# Upstash Redis (Vercel Marketplace): guarda sesiones, URLs de imágenes y auditoría
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# API de conversiones de Meta (servidor)
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
