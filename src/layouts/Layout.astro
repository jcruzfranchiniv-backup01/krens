---
import '@fontsource-variable/inter';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '../styles/base.css';
import '../styles/sections.css';
import '../styles/form.css';
import { getImage } from 'astro:assets';
import { PUBLIC_GA4_ID, PUBLIC_META_PIXEL_ID } from 'astro:env/client';
import { site } from '../content';
import { findImage } from '../lib/images';
import { optimizeImageUrl } from '../core/imageUrl';
import { localBusinessJsonLd } from '../lib/seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title = site.seo.title, description = site.seo.description, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogRemote = Astro.locals.images?.[site.seo.ogImage];
const ogSource = ogRemote ? undefined : findImage(site.seo.ogImage);
const og = ogSource ? await getImage({ src: ogSource, width: 1200, height: 630, format: 'jpeg', fit: 'cover' }) : undefined;
const ogUrl = ogRemote
  ? optimizeImageUrl(ogRemote, { width: 1200, ratio: '1200 / 630' })
  : og
    ? new URL(og.src, Astro.site).href
    : undefined;
const jsonLd = localBusinessJsonLd(Astro.site?.href ?? canonical, ogUrl);

const pixel = PUBLIC_META_PIXEL_ID;
const ga = PUBLIC_GA4_ID;
const pixelSnippet = pixel
  ? `!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${pixel}');fbq('track','PageView');`
  : '';
const gaSnippet = ga ? `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}window.gtag=gtag;gtag('js',new Date());gtag('config','${ga}');` : '';
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f5f0e6" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={site.brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && <meta property="og:image:width" content="1200" />}
    {ogUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogUrl ? 'summary_large_image' : 'summary'} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {pixelSnippet && <script is:inline set:html={pixelSnippet} />}
    {ga && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`}></script>}
    {gaSnippet && <script is:inline set:html={gaSnippet} />}
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <WhatsAppFab />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
