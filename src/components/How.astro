---
import { site } from '../content';

const { how } = site;
---

<section class="section" aria-labelledby="how-title">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">{how.eyebrow}</p>
      <h2 id="how-title">{how.title}</h2>
    </header>
    <ol class="steps">
      {
        how.steps.map((step) => (
          <li class="step reveal">
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
